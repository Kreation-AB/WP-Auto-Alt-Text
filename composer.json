{
    "name": "kimbranzell/auto-alt-text",
    "description": "A WordPress plugin that automatically generates alt text for images.",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.0"
    },
    "authors": [
        {
            "name": "Kim Branzell",
            "email": "hej@jagheter.kim"
        }
    ],
    "extra": {
        "installer-paths": {
            "wp-content/plugins/{$name}/": ["type:wordpress-plugin"]
        }
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "process-timeout": 0,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "digitalrevolution/php-codesniffer-baseline": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "digitalrevolution/php-codesniffer-baseline": "^1.1",
        "php-stubs/woocommerce-stubs": "^11.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint:php": "@php bin/lint-php.php wp-auto-alt-text.php includes admin eval tests bin",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "fixtures:record": "@php bin/record-openai-fixtures.php",
        "check": ["@lint:php", "@lint", "@analyse", "@test"]
    }
}
