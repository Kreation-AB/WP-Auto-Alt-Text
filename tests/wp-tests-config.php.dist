<?php
/*
 * Test-suite configuration template for wp-phpunit.
 *
 * `bin/install-wp-tests.sh` writes `wp-tests-config.php` from this file (ABSPATH
 * and the DB_* constants are substituted). You can also copy it by hand and
 * adjust those. `wp-tests-config.php` is git-ignored because it's
 * machine-specific — do not commit it.
 */

define( 'ABSPATH', dirname( __DIR__ ) . '/.wp-core/' );

define( 'DB_NAME', 'wp_aat_tests' );
define( 'DB_USER', 'root' );
define( 'DB_PASSWORD', '' );
define( 'DB_HOST', 'localhost' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

$table_prefix = 'wptests_';

define( 'WP_TESTS_DOMAIN', 'example.org' );
define( 'WP_TESTS_EMAIL', 'admin@example.org' );
define( 'WP_TESTS_TITLE', 'Test Blog' );
define( 'WP_PHP_BINARY', 'php' );

define( 'WP_DEBUG', true );
define( 'WP_TESTS_PHPUNIT_POLYFILLS_PATH', dirname( __DIR__ ) . '/vendor/yoast/phpunit-polyfills' );
