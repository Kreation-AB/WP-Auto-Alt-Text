			identifier: method.unused
			count: 1
			path: includes/class-statistics-page.php

		-
			message: '#^Parameter \#1 \$args of function paginate_links expects array\{base\?\: string, format\?\: string, total\?\: int, current\?\: int, aria_current\?\: string, show_all\?\: bool, end_size\?\: int, mid_size\?\: int, \.\.\.\}, array\{base\: string, format\: '''', current\: int\<1, max\>, total\: float, prev_next\: true, prev_text\: string, next_text\: string, type\: ''array''\} given\.$#'
