		-
			message: '#^Method Auto_Alt_Text_OpenAI\:\:callAPI\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: includes/class-openai.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: includes/class-rate-limiter.php

		-
