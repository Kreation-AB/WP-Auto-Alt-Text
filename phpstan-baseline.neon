parameters:
	ignoreErrors:
		-
			message: '#^Action callback returns array but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: admin/class-admin.php

		-
			message: '#^Call to function method_exists\(\) with WP_Screen and ''is_block_editor'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: admin/class-admin.php

		-
			message: '#^Static method Auto_Alt_Text_Activator\:\:column_exists\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: includes/class-activator.php

		-
			message: '#^Strict comparison using \!\=\= between list\<non\-empty\-string\|null\> and false will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: includes/class-activator.php

		-
			message: '#^Strict comparison using \=\=\= between mixed~''1\.3'' and ''1\.3'' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: includes/class-activator.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 12
			path: includes/class-ajax-handler.php

		-
			message: '#^Call to function in_array\(\) with arguments ''da'', array\{''sv'', ''no'', ''dk'', ''fi'', ''en'', ''es'', ''fr'', ''de'', \.\.\.\} and true will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: includes/class-cli.php

		-
			message: '#^Call to function is_string\(\) with non\-falsy\-string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/class-cli.php

		-
			message: '#^Call to function method_exists\(\) with ''WP_CLI'' and ''warning'' will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: includes/class-cli.php

		-
			message: '#^Call to static method error\(\) on an unknown class WP_CLI\.$#'
			identifier: class.notFound
			count: 15
			path: includes/class-cli.php

		-
			message: '#^Call to static method halt\(\) on an unknown class WP_CLI\.$#'
